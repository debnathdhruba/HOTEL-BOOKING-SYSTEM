# APPLICATION VARIABLES
APP_NAME=hotel-room-booking-system
APP_PORT=3035
APP_NODE_ENV=development
APP_BASE_URL=http://localhost:3035
APP_SERVICE_URL=http://localhost:3034
APP_LOG_LEVEL=info

# DATABASE VARIABLES
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Uploaded room images and avatars are stored in MongoDB GridFS.

# JWT VARIABLES
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_REFRESH_TOKEN_SECRET_KEY=replace-with-a-different-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES=15m
JWT_REFRESH_TOKEN_EXPIRES=7d
JWT_TOKEN_COOKIE_EXPIRES=7
SEED_ADMIN_PASSWORD=choose-a-long-local-admin-password

# EMAIL VARIABLES
SEND_SENDER_MAIL=verified-sender@example.com
SEND_GRID_API_KEY=replace-with-sendgrid-api-key
